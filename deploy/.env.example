# ============================================================================
# erix-station 本地开发栈环境参数（copy 到 deploy/.env 后按需修改；.env 不入库）
# 依据：docs/env.md §0（开发期） + docs/design/deploy-contract.md
# ⚠️ 含口令的 .env 文件权限必须为 600；生产环境所有 change-me-dev-only 都必须改掉。
# ============================================================================

# ---- 镜像 pin（P1 开发期 patch tag；生产再 pin digest，env §10） ----
POSTGRES_IMAGE=postgres:16.15
TRAEFIK_IMAGE=traefik:v3.7.13
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.5.0

# ---- 网络 ----
# backend 显式子网。规范值 172.30.0.0/24（deploy-contract §2.1）；本机 172.30.0.0/16
# 已被 voiceprint_default 占用，开发期改用 172.32.0.0/24（env §0）。
BACKEND_SUBNET=172.32.0.0/24

# ---- 端口（开发期，env §0） ----
# Traefik host 网络 entrypoint：web / websecure
TRAEFIK_WEB_PORT=8090
TRAEFIK_WEBSECURE_PORT=8443
# portal 宿主发布端口（仅回环）；容器内固定 8080。本机 8080 被占 → 开发期 18080。
PORTAL_HOST_PORT=18080

# ---- 数据库（超级用户，仅初始化/迁移 bootstrap 用） ----
POSTGRES_USER=station
POSTGRES_PASSWORD=change-me-dev-only          # ⚠️ 必须改
POSTGRES_DB=station

# ---- 数据库角色口令（600 权限注入；deploy-contract §2.4） ----
# station_platform = 迁移身份（DDL）；station_portal = 运行时身份（最小 DML）。
PLATFORM_DB_USER=station_platform
PLATFORM_DB_PASSWORD=change-me-dev-only       # ⚠️ 必须改
PORTAL_DB_USER=station_portal
PORTAL_DB_PASSWORD=change-me-dev-only         # ⚠️ 必须改

# ---- portal ----
BASE_DOMAIN=localhost
# prod -> __Host-fde_session + Secure；dev-http -> fde_session_dev + 无 Secure（仅本机 HTTP 联调）
COOKIE_PROFILE=dev-http
SESSION_TTL_SECONDS=604800

# ---- WP2a：用户空间物化 + 路由 reconciler（宿主路径，供 compose 挂载；容器内路径固定） ----
# 用户空间根（开发期隔离可指向临时目录；生产 /srv/erix/users，env §6）。
ERIX_USERSPACE_ROOT_HOST=/srv/erix/users
# Traefik 动态配置目录（portal 写方与 Traefik 只读方共享的宿主目录；deploy-contract §4.2）。
TRAEFIK_DYNAMIC_DIR_HOST=./traefik/dynamic
# 端口配额 / 默认池 / 保留网段（IPAM）。保留网段逗号分隔（如后端子网），逗号分隔。
PORT_QUOTA=40
FDE_POOL=default
IPAM_RESERVED_SUBNETS=
FDE_USER_UID=1000
FDE_USER_GID=1000
