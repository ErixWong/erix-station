# ============================================================================
# erix-station 本地开发栈环境参数（copy 到 deploy/.env 后按需修改；.env 不入库）
# 依据：docs/env.md §0（开发期） + docs/design/deploy-contract.md
# ⚠️ 含口令的 .env 文件权限必须为 600；生产环境所有 change-me-dev-only 都必须改掉。
# ============================================================================

# ---- 镜像 pin（P1 开发期 patch tag；生产再 pin digest，env §10） ----
POSTGRES_IMAGE=postgres:16.15
TRAEFIK_IMAGE=traefik:v3.7.13
# 自研 admission proxy（替换 tecnativa/docker-socket-proxy）；本地 build，无需外镜像 pin

# ---- 网络 ----
# backend 显式子网。规范值 172.30.0.0/24（deploy-contract §2.1）；本机 172.30.0.0/16
# 已被 voiceprint_default 占用，开发期改用 172.32.0.0/24（env §0）。
BACKEND_SUBNET=172.32.0.0/24

# 端口（开发期，env §0） ----
# Traefik host 网络 entrypoint：web / websecure
TRAEFIK_WEB_PORT=8090
TRAEFIK_WEBSECURE_PORT=8443
# 容器经 Traefik 访问 portal/LLM 的公共入口 base URL（scheme://host[:port]）。
# 留空则按 TRAEFIK_ENTRYPOINT 推导：web→http://station.<base>:<WEB_PORT>，websecure→https://station.<base>[:443]。
# 由 ERIX_STATION_BASE_URL（agentd）与 config.json endpoint（worker provider）使用。
PORTAL_PUBLIC_BASE_URL=
LLM_PUBLIC_BASE_URL=
# portal 宿主发布端口（仅回环）；容器内固定 8080。本机 8080 被占 → 开发期 18080。
PORTAL_HOST_PORT=18080

# ---- 数据库（超级用户，仅初始化/迁移 bootstrap 用） ----
POSTGRES_USER=station
POSTGRES_PASSWORD=change-me-dev-only          # ⚠️ 必须改
POSTGRES_DB=station

# ---- 数据库角色口令（600 权限注入；deploy-contract §2.4） ----
# station_platform = 迁移身份（DDL）；station_portal = 运行时身份（最小 DML）。
PLATFORM_DB_USER=station_platform
PLATFORM_DB_PASSWORD=change-me-dev-only       # ⚠️ 必须改
PORTAL_DB_USER=station_portal
PORTAL_DB_PASSWORD=change-me-dev-only         # ⚠️ 必须改

# ---- portal ----
BASE_DOMAIN=localhost
# prod -> __Host-fde_session + Secure；dev-http -> fde_session_dev + 无 Secure（仅本机 HTTP 联调）
COOKIE_PROFILE=dev-http
SESSION_TTL_SECONDS=604800

# ---- WP2a：用户空间物化 + 路由 reconciler（宿主路径，供 compose 挂载；容器内路径固定） ----
# 用户空间根（开发期隔离可指向临时目录；生产 /srv/erix/users，env §6）。
ERIX_USERSPACE_ROOT_HOST=/srv/erix/users
# Traefik 动态配置目录（portal 写方与 Traefik 只读方共享的宿主目录；deploy-contract §4.2）。
TRAEFIK_DYNAMIC_DIR_HOST=./traefik/dynamic
# 端口配额 / 默认池 / 保留网段（IPAM）。保留网段逗号分隔（如后端子网），逗号分隔。
PORT_QUOTA=40
FDE_POOL=default
IPAM_RESERVED_SUBNETS=
FDE_USER_UID=1000
FDE_USER_GID=1000

# ---- LLM 网关（P1 mock/占位，真实网关 P2+ 接入；topology §4-L7 / fde-platform §11）----
# LLM 网关数据面回环地址（reconciler 生成 llm-hub service 时用）。
LLM_GATEWAY_HOST=http://127.0.0.1:4000
# station-mock-llm 数据面在宿主的回环发布端口（dev-only；P3 真实网关同端口）
LLM_GATEWAY_PORT=4000

# ---- WP2b：FDE provisioning + preview ticket ----
# FDE 容器镜像/命令（开发期 traefik/whoami 站台；生产自构建 runner 镜像，deploy-contract §6）。
# 真实 runner 镜像（WP3b）：FDE_IMAGE=erix-station/fde:local、FDE_DEV_MODE=0、FDE_DEV_USER=（空，不用 --user）、
# FDE_CMD=（空，镜像 ENTRYPOINT 直接 station-agentd）。
FDE_IMAGE=traefik/whoami
# proxy 镜像白名单与 FDE_IMAGE 同源（compose 内直接引用 FDE_IMAGE，全串精确匹配）
# 允许的容器 Memory 上限（字节；0 = 不限，proxy MAX_MEMORY）
FDE_MEMORY_LIMIT_MAX=0
# 允许的容器 PidsLimit 上限（0 = 不限，proxy MAX_PIDS）
FDE_PIDS_LIMIT_MAX=0
# 允许的容器 User 值（逗号分隔；proxy ALLOWED_USERS，默认 1001:1000）
FDE_ALLOWED_USERS=1001:1000
# 允许的 network create subnet 池（逗号分隔 CIDR；proxy IPAM_POOLS）
FDE_IPAM_POOLS=10.200.0.0/16,10.201.0.0/16
# FDE_DEV_MODE=1 显式开发模式（F12/F14）；生产设 0 或 NODE_ENV=production
FDE_DEV_MODE=1
# F5：开发期 whoami 镜像不满足「root 启动→drop 1001」契约时的 --user 兜底（⚠️ dev 偏差）
FDE_DEV_USER=1001:1000
# FDE_CMD 为 JSON 数组；whoami 站台默认监听 4000（= 首个项目块首端口，fde-platform §8.2）。
FDE_CMD=["-port","4000"]
FDE_AGENT_VERSION=dev
FDE_MEMORY_LIMIT=512m
FDE_AGENTD_UID=1001
FDE_WORKER_UID=1002
# 预览 session 派生密钥（HMAC-SHA256，portal.md §2.7）；生产必须改为强随机值。
SESSION_SIGNING_KEY=erix-station-dev-signing-key-change-me
PREVIEW_TICKET_TTL_SECONDS=60
PREVIEW_SESSION_TTL_SECONDS=900
