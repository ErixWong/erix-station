# ============================================================================
# erix-station 本地开发栈环境参数（copy 到 deploy/.env 后按需修改；.env 不入库）
# 依据：docs/env.md §0（开发期） + docs/design/deploy-contract.md
# ⚠️ 含口令的 .env 文件权限必须为 600；生产环境所有 change-me-dev-only 都必须改掉。
# ============================================================================

# ---- 镜像 pin（P1 开发期 patch tag；生产再 pin digest，env §10） ----
POSTGRES_IMAGE=postgres:16.15
TRAEFIK_IMAGE=traefik:v3.7.13
# 自研 admission proxy（替换 tecnativa/docker-socket-proxy）；本地 build，无需外镜像 pin

# ---- 自构建三镜像的引用：compose 层 fail-closed，缺值即拒（#643）----
# 下面三行**一律留空**。留空 = 起栈照样被拒：compose 写的是 `${VAR:?}`，
# 空值也算缺失（compose 2.40 实测）。刻意如此：`deploy/.env` 不入库 ⇒
# 带缺省值就等于允许没有它的那次 `up -d` 静默换掉**共享 dev 栈**的镜像。
# 口径：复制本模板 ≠ 已声明要动共享栈。要动就填一行，两种合法形态：
#   形态① scratch 本地构建（tag 明写 `:local`）：
#     STATION_PORTAL_IMAGE=erix-station/portal:local
#     STATION_DOCKER_PROXY_IMAGE=erix-station/fde-proxy:local
#     FDE_IMAGE=traefik/whoami（站台）或 erix-station/fde:local（自建 runner 镜像）
#   形态② 部署/发布 pin 不可变引用（digest 双轨，#27）：
#     STATION_PORTAL_IMAGE=ghcr.io/erixwong/erix-station-portal@sha256:<digest>
#     STATION_DOCKER_PROXY_IMAGE=ghcr.io/erixwong/erix-station-fde-proxy@sha256:<digest>
#     FDE_IMAGE=ghcr.io/erixwong/erix-station-fde@sha256:<digest>
STATION_PORTAL_IMAGE=
STATION_DOCKER_PROXY_IMAGE=
FDE_IMAGE=

# ---- 网络 ----
# backend 显式子网。规范值 172.30.0.0/24（deploy-contract §2.1）；本机 172.30.0.0/16
# 已被 voiceprint_default 占用，开发期改用 172.32.0.0/24（env §0）。
BACKEND_SUBNET=172.32.0.0/24

# 端口（开发期，env §0） ----
# Traefik host 网络 entrypoint：web / websecure
TRAEFIK_WEB_PORT=8090
TRAEFIK_WEBSECURE_PORT=8443
# issue #450：管理台独立入口（独立 host + TLS）。默认 9443，避开 80/443/8090/8443 与号池 22000–29999。
# ⚠ 两处耦合：Traefik 的 listen 端口在 `deploy/traefik/traefik.yml` 的 `adminsecure.address` 里**写死**
#   （静态文件不做 `${VAR}` 插值；station-edge 是 network_mode: host ⇒ 宿主端口 = 容器端口）。
#   改端口必须同时改静态文件那一行，且改完要重启边缘（静态配置只在启动时读）。
TRAEFIK_ADMIN_PORT=9443
# 管理台对外 host：留空 = admin.<BASE_DOMAIN>（泛解析已覆盖，零 DNS 动作）。
ADMIN_PUBLIC_HOST=
# 管理台入口来源白名单（逗号分隔 CIDR）：**留空 = 放行全部（现状）**；非空 = 只放行这些网段（其余 403）。
ADMIN_IP_ALLOWLIST=
# 容器经 Traefik 访问 portal/LLM 的公共入口 base URL（scheme://host[:port]）。
# 留空则按 TRAEFIK_ENTRYPOINT 推导：web→http://station.<base>:<WEB_PORT>，websecure→https://station.<base>[:443]。
# 由 ERIX_STATION_BASE_URL（agentd）与 config.json endpoint（worker provider）使用。
PORTAL_PUBLIC_BASE_URL=
LLM_PUBLIC_BASE_URL=
# 仅扩展 internal API router 的 Host，逗号分隔；不改变 portal UI 的 PORTAL_HOST。
PORTAL_INTERNAL_HOSTS=
# portal 宿主发布端口（仅回环）；容器内固定 8080。本机 8080 被占 → 开发期 18080。
PORTAL_HOST_PORT=18080

# ---- 数据库（超级用户，仅初始化/迁移 bootstrap 用） ----
POSTGRES_USER=station
POSTGRES_PASSWORD=change-me-dev-only          # ⚠️ 必须改
POSTGRES_DB=station

# ---- 数据库角色口令（600 权限注入；deploy-contract §2.4） ----
# station_platform = 迁移身份（DDL）；station_portal = 运行时身份（最小 DML）。
PLATFORM_DB_USER=station_platform
PLATFORM_DB_PASSWORD=change-me-dev-only       # ⚠️ 必须改
PORTAL_DB_USER=station_portal
PORTAL_DB_PASSWORD=change-me-dev-only         # ⚠️ 必须改

# ---- portal ----
BASE_DOMAIN=localhost
# prod -> __Host-fde_session + Secure；dev-http -> fde_session_dev + 无 Secure（仅本机 HTTP 联调）
COOKIE_PROFILE=dev-http
SESSION_TTL_SECONDS=604800
# 单个上传文件的字节上限（#472 片 B，`POST /api/files/upload`；留空=32MiB。与 JSON 请求体上限（默认 64 KiB，
# `http.js` 的 `DEFAULT_JSON_BODY_LIMIT`，见 #677）是两个旋钮，见 docs/api/portal.md §4.14 / docs/env.md §10.1）
# FILE_UPLOAD_MAX_BYTES=33554432
# 读 upload_settings 的超时（毫秒，#485 片 A 复 audit）。每次上传都要现读一次这个单行表，
# 「查询发出去而不返回」会把每次上传挂住 ⇒ 到点按「读不到」处理（回落 env/默认，`reason=read_timeout`，
# 上传照常）。只接受正整数，给了别的形状 ⇒ 默认 1500 + 一条 warn。详见 docs/env.md §10.1。
# ⚠ 超时只保证**调用方不挂**：它不取消已发出的查询、也不回收
#   那根连接（node-pg 没有中断已发查询的 API，见 docs/env.md §10.1）。
# UPLOAD_SETTINGS_READ_TIMEOUT_MS=1500

# 读 platform_prompts（管理台「提示词」面板，#596 片 A）的超时（毫秒）。
# 物化与改名每次都要现读这一行 ⇒ 「查询发出去而不返回」会把它们挂住 ⇒ 到点按
# 「读不到」处理：回落内置提示词、`reason=read_timeout`、物化与改名照常。
# 只接受**严格十进制正整数**（`1e3` 不算），别的形状 ⇒ 默认 1500 + 一条 warn。
# 详见 docs/env.md §10.1 与 docs/api/portal.md §4.19。
# ✅ #596 返修 F5：上面两根已经真的写进 `deploy/docker-compose.yml`
#   的 `station-portal.environment`（`${VAR:-1500}` 形态）⇒ 改完 `deploy/.env`
#   再 `docker compose up -d station-portal` 就生效。此前那句「compose
#   没登记 ⇒ 配了不生效」的已知遗留已销账。
#   三腿一致性（compose 插值缺省 == 代码常量 == 读取路径真正用的毫秒）
#   的机器判据：`portal/test/deploy-env-read-timeout.test.js`。
# ⚠ 超时只保证**调用方不挂**：同样不取消已发出的查询、也不回收
#   那根连接（与上面那根同一取舍：node-pg 没有中断已发查询的 API，
#   刻意**不**引入 `statement_timeout`，见 docs/env.md §10.1）。
# PLATFORM_PROMPTS_READ_TIMEOUT_MS=1500

# ---- 后台循环的空闲退避上限（issue #520；全部注释掉 = 用代码缺省，与不设逐字等价） ----
# 三个队列循环（开户 onboarding / 销号 offboarding / 对账 provisioner）在**连续没活**时按
# 5000→10000→20000→… 翻倍退避到下面这个上限封顶；**一认领到活就立即回 5000**。
# ⇒ 这三根旋钮只改「平台空闲时多久问一次 DB（= 空闲写事务量）」，不改有活时的吞吐。
# 值必须是严格正整数（`1e4` / `10000abc` / 负数 都不认：warn 并回落缺省）。
# ⚠ `PROVISIONER_IDLE_BACKOFF_MAX_MS` 是**硬上限**：写超过 15000 会被钳到 15000 并在 portal 日志
#   warn 点名旋钮（对账的漂移发现延迟是业务承诺，不许被一个 env 悄悄放宽）；另两个可配到 60000。
# 想回到 #520 之前的固定 5s 节拍：三根都配 5000。
# 这三行必须同时出现在 `deploy/docker-compose.yml` 的 `station-portal.environment` 里（那里是显式
# environment 列表、无 env_file，不登记则本文件写什么都无效）；一致性由
# `portal/test/deploy-env-idle-backoff.test.js` 钉住。
# ONBOARDING_IDLE_BACKOFF_MAX_MS=30000
# OFFBOARDING_IDLE_BACKOFF_MAX_MS=30000
# PROVISIONER_IDLE_BACKOFF_MAX_MS=15000

# ---- WP2a：用户空间物化 + 路由 reconciler（宿主路径，供 compose 挂载；容器内路径固定） ----
# 用户空间根（开发期隔离可指向临时目录；生产 /srv/erix/users，env §6）。
ERIX_USERSPACE_ROOT_HOST=/srv/erix/users
# workspace 自动清理保留天数；默认 0 永不自动清理，显式正数只清目录、不删数据库记录。
ERIX_WORKSPACE_RETENTION_DAYS=0
# Traefik 动态配置目录（portal 写方与 Traefik 只读方共享的宿主目录；deploy-contract §4.2）。
TRAEFIK_DYNAMIC_DIR_HOST=./traefik/dynamic
# 默认池 / 保留网段（IPAM）。保留网段逗号分隔（如后端子网），逗号分隔。
FDE_POOL=default
IPAM_RESERVED_SUBNETS=
FDE_USER_UID=1000
FDE_USER_GID=1000

# ---- LLM 网关（issue #117；topology §4-L7 / fde-platform §11）----
# Traefik host network 访问 LiteLLM data plane 的回环地址。
LLM_GATEWAY_HOST=http://127.0.0.1:4100
# LiteLLM 在宿主的回环发布端口（隔离 e2e 栈应设置为独立端口）。
LITELLM_HOST_PORT=4100

# ---- LiteLLM（issue #117；只在 --profile litellm 时启动）----
# 生成独立随机值；deploy/.env 权限设为 600，勿提交。
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=
LLM_GATEWAY_ADMIN_URL=http://station-litellm:4000

# ---- WP2b：FDE provisioning + preview ticket ----
# FDE 容器镜像/命令（开发期 traefik/whoami 站台；生产自构建 runner 镜像，deploy-contract §6）。
# 真实 runner 镜像（WP3b）：FDE_IMAGE=erix-station/fde:local、FDE_DEV_MODE=0、FDE_DEV_USER=（空，不用 --user）、
# FDE_CMD=（空，镜像 ENTRYPOINT 直接 station-agentd）。
# 生产 pin（issue #27 双轨，二选一，F12 校验）：
#   repo digest：FDE_IMAGE=erix-station/fde:1.0.0-<sha>@sha256:<digest>（push/pull 后 `docker inspect --format '{{index .RepoDigests 0}}'` 取）
#   image ID：  FDE_IMAGE=sha256:<imageId>（目标机本地 build，`docker inspect --format '{{.Id}}'` 取；本地 build RepoDigests 为空）
# FDE_IMAGE 与另两根自构建镜像登记在上面「自构建三镜像的引用」节。
# 它同时是 proxy 的 IMAGE_ALLOWLIST（compose 内同源，全串精确匹配）。
# 允许的容器 Memory 上限（字节；0 = 不限，proxy MAX_MEMORY）
FDE_MEMORY_LIMIT_MAX=0
# 允许的容器 PidsLimit 上限（0 = 不限，proxy MAX_PIDS）
FDE_PIDS_LIMIT_MAX=0
# 允许的容器 User 值（逗号分隔；proxy ALLOWED_USERS，默认 1001:1000）
FDE_ALLOWED_USERS=1001:1000
# 允许的 network create subnet 池（逗号分隔 CIDR；proxy IPAM_POOLS）——这是**放行面**，不是分配器。
# ⚠ portal 实际从哪一段切由下面两个 IPAM 池旋钮决定；分配段必须整体落在本变量的放行面之内。
FDE_IPAM_POOLS=10.200.0.0/16,10.201.0.0/16
# IPAM 分配段（issue #270，去前缀后下发给 portal 的 IPAM_POOL_DEFAULT / IPAM_POOL_LARGE）。
# 缺省值逐字 = 旧硬编码值（不设 ⇒ 行为零变化）；前缀长度不可配（/29 与 /28，DDL CHECK 钉的）。
# 取值必须是规范网络地址且不得跑出该池的保留段（default ⇒ 10.200.0.0/16 内，large ⇒ 10.201.0.0/16 内）。
# 并行隔离栈：每栈取一段不同的子段（例 10.201.37.0/24），同时把它加进上面的 FDE_IPAM_POOLS。
FDE_IPAM_POOL_DEFAULT=10.200.0.0/16
FDE_IPAM_POOL_LARGE=10.201.0.0/16
# FDE_DEV_MODE=1 显式开发模式（F12/F14）；生产设 0 或 NODE_ENV=production
FDE_DEV_MODE=1
# F5：开发期 whoami 镜像不满足「root 启动→drop 1001」契约时的 --user 兜底（⚠️ dev 偏差）
FDE_DEV_USER=1001:1000
# FDE_CMD 为 JSON 数组；whoami 站台默认监听 4000（= 首个项目块首端口，fde-platform §8.2）。
FDE_CMD=["-port","4000"]
FDE_AGENT_VERSION=dev
# FDE 内存限额（issue #27 已决 2026-09-18：默认 4g；`0` 不限。B 档镜像下 dotnet build/chromium 峰值需要）
FDE_MEMORY_LIMIT=4g
FDE_WORKER_UID=1002
# 预览 session 派生密钥（HMAC-SHA256，portal.md §2.7）；生产必须改为强随机值。
SESSION_SIGNING_KEY=erix-station-dev-signing-key-change-me
PREVIEW_TICKET_TTL_SECONDS=60
PREVIEW_SESSION_TTL_SECONDS=900

# issue #557：终局正文「被文本化的工具调用」特征集（逗号分隔整串替换；`off` = 显式关闭）。
# 留注释 = 用 runner 代码缺省五条（真值在 runner/lib/final-text-toolcall.js，别在这里抄一份）。
# 三腿同改：compose station-portal env → provisioner Env 注入 → fde-proxy ENV_KEY_ALLOW。
# ERIX_FINAL_TEXT_TOOLCALL_MARKERS=
