{
  "name": "erix-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FDE Station — 给 FDE 用的开发工位平台（宿主平台）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:integration": "node --test portal/integration/wp2a-e2e.mjs",
    "test:integration:wp2b": "node --test portal/integration/wp2b-e2e.mjs",
    "test:integration:wp3a": "node --test portal/integration/wp3a-e2e.mjs",
    "test:integration:wp3b": "node --test portal/integration/wp3b-e2e.mjs",
    "test:integration:db": "node --test portal/integration/db-integration.mjs",
    "start": "node portal/src/cli.js serve",
    "db:migrate": "node portal/src/cli.js migrate",
    "healthcheck": "node portal/src/cli.js healthcheck"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
