{
  "name": "erix-station",
  "version": "0.1.80",
  "private": true,
  "type": "module",
  "description": "FDE Station \u2014 \u7ed9 FDE \u7528\u7684\u5f00\u53d1\u5de5\u4f4d\u5e73\u53f0\uff08\u5bbf\u4e3b\u5e73\u53f0\uff09",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test && node scripts/check-integration-syntax.mjs",
    "test:integration": "node --test portal/integration/wp2a-e2e.mjs",
    "test:integration:wp3a": "node --test portal/integration/wp3a-e2e.mjs",
    "test:integration:wp3b": "node --test portal/integration/wp3b-e2e.mjs",
    "test:integration:wp4": "node --test portal/integration/wp4-acceptance.mjs",
    "test:integration:wp5": "node --test portal/integration/wp5-e2e.mjs",
    "test:integration:wp6": "node --test portal/integration/wp6-llm-e2e.mjs",
    "test:integration:version": "node --test portal/integration/version-surface-e2e.mjs",
    "test:integration:seat": "node --test portal/integration/seat-content-e2e.mjs",
    "test:integration:llm-usage": "node --test portal/integration/llm-usage-e2e.mjs",
    "test:integration:user-usage": "node --test portal/integration/user-usage-e2e.mjs",
    "test:integration:locale": "node --test portal/integration/admin-locale-e2e.mjs",
    "test:integration:db": "node --test portal/integration/db-integration.mjs",
    "test:integration:prompts": "node --test portal/integration/platform-prompts-db.mjs",
    "test:integration:prompts-ui": "node --test portal/integration/prompts-effective-e2e.mjs",
    "start": "node portal/src/cli.js serve",
    "db:migrate": "node portal/src/cli.js migrate",
    "healthcheck": "node portal/src/cli.js healthcheck",
    "check:agents-hotlayer": "node scripts/agents-hotlayer-budget.mjs",
    "check:doc-portable": "node scripts/check-doc-portable.mjs",
    "check:ci-legs": "node scripts/check-required-legs.mjs",
    "check:doc-impl": "node scripts/check-doc-impl.mjs",
    "check:frontend": "env -u NODE_ENV npm --prefix portal/frontend run typecheck && env -u NODE_ENV npm --prefix portal/frontend test",
    "check:integration-syntax": "node scripts/check-integration-syntax.mjs"
  },
  "dependencies": {
    "erix-agent": "0.33.0",
    "nodemailer": "10.3.1",
    "pg": "^8.23.0",
    "yaml": "2.9.1"
  }
}
